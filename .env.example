ODOO_IMAGE=odoo:17
PG_IMAGE=postgres:16
POSTGRES_USER=odoo17
POSTGRES_PASSWORD=odoo@17
POSTGRES_DB=postgre
ODOO_ADMIN_PASSWORD=Admin@17
ODOO_HTTP_PORT=10017
ODOO_CHAT_PORT=20017
ODOO_NETWORK=odoo17_internal
ODOO_CONTAINER_NAME=odoo17
ODOO_DB_CONTAINER_NAME=odoo17-db

# Used only with docker-compose.traefik.yml
ODOO_DOMAIN=odoo.example.com
DOCKER_PROXY_NETWORK=proxy
CERTSRESOLVER=letsencrypt
