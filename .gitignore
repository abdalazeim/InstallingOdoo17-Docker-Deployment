# Odoo 17 Multi-Instance Deployment - .gitignore
# يستثني مجلدات البيانات والأسرار والسجلات من التحكم بالإصدار.

# أسرار ومتغيرات بيئة
.env
*.env
group_vars/vault.yml
.vault_pass

# مجلدات البيانات
postgresql/
data/
filestore/

# سجلات
*.log
etc/odoo-server.log
etc/sessions/

# مجلدات النظام
__pycache__/
*.pyc
.DS_Store
.vscode/
.idea/
node_modules/

# مجلدات النشر
/opt/odoo17/
/data/odoo17/
/data/backups/

# ملفات مؤقتة
*.tmp
*.bak
*~